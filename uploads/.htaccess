# Deny script execution in uploads
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|phtml|php3|php4|php5|php7|phps)$ - [F,L]
</IfModule>

# Only allow image files
<FilesMatch "\.(?i:jpe?g|png|gif|webp|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
